  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "在大太陽下跑了一小時、喝了三瓶水，可見他很「口渴」。",
          "evidence": [
            "drank three bottles of water"
          ],
          "blank_pos": "adjective",
          "clue_type": "cause_effect",
          "sense": "core",
          "option_notes_zh": {
            "B": "honest「誠實的」，和喝水沒有關係。",
            "C": "polite「有禮貌的」，不是跑步後的身體感覺。",
            "D": "famous「有名的」，和前後文無關。"
          },
          "strategy_zh": "找出空格前後的因果關係：前面是原因，後面是結果。",
          "hints": [
            "空格要一個形容詞，描述 Tom 的感覺。",
            "看句子後半：他做了什麼？",
            "刪去 C、D：和身體感覺無關。"
          ]
        },
        "2": {
          "explanation_zh": "要關手機、小聲說話，表示圖書館是「安靜的」地方。",
          "evidence": [
            "keep your voice down"
          ],
          "blank_pos": "adjective",
          "clue_type": "definition_restatement",
          "sense": "core",
          "option_notes_zh": {
            "A": "noisy「吵鬧的」，和「小聲說話」相反。",
            "B": "crowded「擁擠的」，不是要關手機的原因。",
            "D": "dirty「髒的」，和小聲說話無關。"
          },
          "strategy_zh": "so 後面是結果，回頭找能推出這個結果的形容詞。",
          "hints": [
            "空格修飾 place，需要形容詞。",
            "so 後面說要做什麼？",
            "刪去 A、D。"
          ]
        },
        "3": {
          "explanation_zh": "存了好幾個月的錢，是為了「買得起」新腳踏車。",
          "evidence": [
            "saved money for months"
          ],
          "blank_pos": "verb",
          "clue_type": "cause_effect",
          "sense": "core",
          "option_notes_zh": {
            "A": "borrow「借入」，存錢不是為了借。",
            "C": "refuse「拒絕」，語意相反。",
            "D": "waste「浪費」，和存錢矛盾。"
          },
          "strategy_zh": "so that 表示目的，空格要和前面的行動目的一致。",
          "hints": [
            "could 後面接原形動詞。",
            "存錢的目的是什麼？",
            "刪去 C、D。"
          ]
        },
        "4": {
          "explanation_zh": "因為下大雨，運動會「延期」到下週五。正解是 postpone 的過去分詞 postponed（被動語態 was postponed）。",
          "evidence": [
            "until next Friday"
          ],
          "blank_pos": "verb",
          "clue_type": "cause_effect",
          "sense": "core",
          "option_notes_zh": {
            "B": "celebrated「慶祝」，下大雨不會讓運動會被慶祝到下週。",
            "C": "finished「完成」，和 until next Friday 矛盾。",
            "D": "invited「邀請」，運動會不是被邀請的對象。"
          },
          "strategy_zh": "was ____ until 後面接時間：找「延到某個時間」的動詞。",
          "hints": [
            "was 後面接過去分詞，這是被動語態。",
            "until next Friday 表示時間往後移。",
            "刪去 C：完成了就不會到下週。"
          ]
        },
        "5": {
          "explanation_zh": "麵粉、蛋、糖是蛋糕的「材料」。正解是 ingredient 的複數 ingredients。",
          "evidence": [
            "Flour, eggs, and sugar"
          ],
          "blank_pos": "noun",
          "clue_type": "example",
          "sense": "core",
          "option_notes_zh": {
            "A": "customers「顧客」，不是做蛋糕的東西。",
            "C": "neighbors「鄰居」，和蛋糕無關。",
            "D": "passengers「乘客」，和蛋糕無關。"
          },
          "strategy_zh": "主詞列舉了三樣東西，空格要能概括它們的名詞。",
          "hints": [
            "空格前有 the main，後面接 of，需要名詞。",
            "麵粉、蛋、糖是什麼？",
            "刪去 A、C、D：都是人。"
          ]
        }
      }
    },
