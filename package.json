{
  "name": "gsat-english-center",
  "version": "0.1.0",
  "private": true,
  "description": "學測英文中心：台灣高中生的學測英文備考 App（monorepo：前端 Vite＋React、後端 Cloudflare Worker＋D1）",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,magenta \"npm run dev -w @gsat/web\" \"npm run dev -w @gsat/api\"",
    "dev:web": "npm run dev -w @gsat/web",
    "dev:api": "npm run dev -w @gsat/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:data": "npm run test:data -w @gsat/shared",
    "test:e2e": "npm run build -w @gsat/web && npm run test:e2e -w @gsat/web",
    "lint": "npm run typecheck",
    "validate:exams": "python3 tools/validate_exam.py --all",
    "validate:bank": "python3 tools/validate_bank.py --all",
    "gen:tiers": "node packages/shared/scripts/dump-tiers.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0"
  }
}
