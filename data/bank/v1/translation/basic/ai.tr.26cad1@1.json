  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "整句的主詞是「放學後和朋友組讀書會」這件事，英文用動名詞片語當主詞：Forming（Starting／Having）a study group with friends after school；動名詞主詞視為單數，動詞要用 helps（或 can help）。「互相學習」是 learn from each other，from 不能漏；朋友不只一位，用複數 friends。",
          "evidence": [
            "和朋友組讀書會",
            "互相學習"
          ],
          "strategy_zh": "中文用「做某件事＋可以／會…」開頭時，英文把那件事改成 V-ing 當主詞，再接單數動詞。",
          "hints": [
            "切成四段：放學後／和朋友組讀書會／可以幫助我們／互相學習",
            "標的詞彙：form（組成）、study（讀書）、group（團體）、friend（朋友）、school（學校）、help（幫助）、learn（學習）、each other（互相）",
            "句型框架：V-ing … + helps／can help + 受詞 + 原形動詞 …"
          ]
        },
        "2": {
          "explanation_zh": "「和…一樣清楚」用原級比較 as clear as，中間是原級形容詞；「甚至」放在 as 前面：even as clear as。比較的兩邊要對等：朋友的講解比老師的講解，寫 the teacher's，不寫 the teacher。「朋友們」是複數，所有格寫 friends'，講解用複數 explanations，動詞用 are。",
          "evidence": [
            "朋友們的講解",
            "和老師的一樣清楚"
          ],
          "strategy_zh": "「A 和 B 一樣＋形容詞」→ A + be + as + 原級 + as + B；寫完回頭確認 A、B 是同一類東西。",
          "hints": [
            "切成四段：有時候／朋友們的講解／甚至／和老師的一樣清楚",
            "標的詞彙：sometimes（有時候）、friend（朋友）、explanation（講解）、even（甚至）、clear（清楚的）、teacher（老師）",
            "句型框架：A + be + (even) as + 原級形容詞 + as + B"
          ]
        }
      }
    },
