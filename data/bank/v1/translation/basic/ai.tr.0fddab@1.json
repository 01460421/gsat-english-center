  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "整句的主詞是「冬至和家人一起吃湯圓」這件事，英文用動名詞片語當主詞：Eating tangyuan with family on the winter solstice；動名詞主詞視為單數，動詞用 is。特定的節日用介系詞 on：on the winter solstice。「傳統」是名詞 tradition（或 custom），不是形容詞 traditional。",
          "evidence": [
            "吃湯圓",
            "是一項重要的傳統"
          ],
          "strategy_zh": "中文用「做某件事＋是…」開頭時，把那件事改成 V-ing 當主詞，再接單數動詞 is。",
          "hints": [
            "切成四段：冬至和家人一起／吃湯圓／是一項重要的／傳統",
            "標的詞彙：family（家人）、eat（吃）、important（重要的）、tradition（傳統）",
            "句型框架：V-ing … + is + a/an + 形容詞 + 名詞"
          ]
        },
        "2": {
          "explanation_zh": "「越來越多＋名詞」用 more and more＋複數名詞：more and more young people（people 本身是複數，不寫 young man）。主詞是複數，否定用 do not know。「可惜的是」可寫 Sadly 或 Unfortunately；「由來」是名詞 origin（或 the story behind …）。",
          "evidence": [
            "越來越多年輕人",
            "這個傳統的由來"
          ],
          "strategy_zh": "「越來越多的 N」→ more and more＋複數 N，動詞用複數；「越來越＋形容詞」則用「比較級 and 比較級」。",
          "hints": [
            "切成四段：可惜的是／越來越多年輕人／不知道／這個傳統的由來",
            "標的詞彙：sadly（可惜地）、young（年輕的）、people（人們）、know（知道）、origin（由來）、tradition（傳統）",
            "句型框架：More and more + 複數名詞 + do not + VR …"
          ]
        }
      }
    },
