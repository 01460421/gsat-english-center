  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「好讓自己…能…」表示目的，用 so that＋S＋can＋原形動詞；so that 後面要接完整子句，主詞用 I，不用 myself。「把日記本放在床頭」可寫 keep／put my diary by／next to my bed（日記本就是 diary）。「幾句」是 a few sentences，a few 後面接複數名詞；every 後面則接單數 night。",
          "evidence": [
            "好讓自己",
            "寫幾句"
          ],
          "strategy_zh": "「好讓／以便…能…」→ so that＋S＋can＋VR；先寫完前面的動作，再用 so that 接上目的子句。",
          "hints": [
            "切成四段：我把日記本放在床頭／好讓自己／每天晚上／都能寫幾句",
            "標的詞彙：diary（日記）、bed（床）、night（晚上）、write（寫）、sentence（句子）",
            "句型框架：S + V … so that + S + can + VR …"
          ]
        },
        "2": {
          "explanation_zh": "「到目前為止…已經…」表示從過去累積到現在的結果，用現在完成式 have written（write 的過去分詞是 written）。「到目前為止」是 so far／up to now；「超過一百頁」是 more than（over）one hundred pages，page 用複數；「英文日記」是 my English diary（English 不寫成 England）。",
          "evidence": [
            "到目前為止",
            "已經寫了"
          ],
          "strategy_zh": "看到「到目前為止、已經、至今」先想現在完成式；主詞 I 用 have，接過去分詞。",
          "hints": [
            "切成四段：到目前為止／我已經寫了／超過一百頁／的英文日記",
            "標的詞彙：so far（到目前為止）、write（寫）、more than（超過）、page（頁）、diary（日記）",
            "句型框架：So far, S + have/has + p.p. …"
          ]
        }
      }
    },
