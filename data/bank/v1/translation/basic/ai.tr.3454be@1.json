  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「已經做完」表示到現在已經完成，用現在完成式 have finished／have completed；主詞「我們班的同學」是複數，助動詞用 have，all 可以放在 have 和過去分詞之間。「今年的」寫 this year's（所有格），「健康檢查」是 health check-up（或 health examination），用名詞 health，不用形容詞 healthy。",
          "evidence": [
            "都已經做完",
            "健康檢查"
          ],
          "strategy_zh": "「已經＋動作完成」→ have/has＋p.p.；再看主詞單複數決定用 have 或 has。",
          "hints": [
            "切成四段：我們班的同學／都已經做完／今年的／健康檢查",
            "標的詞彙：student（學生）、class（班級）、finish（完成）、year（年）、health（健康）、check-up（檢查）",
            "句型框架：S + have + (all/already) + p.p. …"
          ]
        },
        "2": {
          "explanation_zh": "「除了…之外，…也…」用 Besides／In addition to＋動名詞：besides 是介系詞，後面的動詞要寫成 measuring。「身高、體重」要用名詞 height、weight，不能寫成形容詞 tall、heavy。健康檢查已經做完，「也檢查了」用過去式 also checked；「視力」是 vision 或 eyesight。",
          "evidence": [
            "除了量身高和體重之外",
            "也檢查了我們的視力"
          ],
          "strategy_zh": "介系詞（besides、by、without、instead of）後面接動詞時，一律改成 V-ing。",
          "hints": [
            "切成四段：除了量身高和體重之外／護理師／也檢查了／我們的視力",
            "標的詞彙：measure（量）、height（身高）、weight（體重）、nurse（護理師）、check（檢查）、vision（視力）",
            "句型框架：Besides + V-ing …, S + also + V …"
          ]
        }
      }
    },
