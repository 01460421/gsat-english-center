  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "這一句有兩個動作「參觀了」和「做了」，用 and 連接成平行結構；上週五是過去的時間，兩個動詞都要用過去式 visited、made。visit 是及物動詞，直接接地點；「觀光工廠」說 tourist factory。「親手做」可寫 made our own chocolate，或 made chocolate ourselves／with our own hands。",
          "evidence": [
            "上週五",
            "還親手做了巧克力"
          ],
          "strategy_zh": "and 前後的動作時態要一致；寫完第二個動詞時，回頭看一次時間副詞（上週五 → 過去式）。",
          "hints": [
            "切成四段：上週五／參觀了／一家觀光工廠／還親手做了巧克力",
            "標的詞彙：last（上一個）、visit（參觀）、tourist（觀光的）、factory（工廠）、make（做）、chocolate（巧克力）",
            "句型框架：S + V1-ed … and V2-ed …（兩個過去式動詞並列）"
          ]
        },
        "2": {
          "explanation_zh": "「帶我們參觀的導覽員」是「…的＋名詞」，英文把修飾語放到名詞後面，用關係代名詞 who 帶出形容詞子句：the guide who showed us around（先行詞是人，用 who 或 that）。主要動詞是 answered；「耐心地」修飾動詞，用副詞 patiently；「所有的問題」用複數 all our questions。",
          "evidence": [
            "帶我們參觀的導覽員",
            "我們所有的問題"
          ],
          "strategy_zh": "中文「…的＋人」時，先寫出那個人（the guide），再用 who＋動詞補上「…的」部分，最後才接主要動詞。",
          "hints": [
            "切成四段：在工廠裡／帶我們參觀的導覽員／耐心地／回答了我們所有的問題",
            "標的詞彙：factory（工廠）、guide（導覽員）、show（帶…參觀，show sb around）、patiently（耐心地）、answer（回答）、question（問題）",
            "句型框架：the + 人 + who + V …, 再接主要動詞 …"
          ]
        }
      }
    },
