  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「…的地方」修飾地點時，英文把 the place 放前面，後面用關係副詞 where 引導子句：the place where I first baked a cake。也可以把 The place where … 當主詞放在句首。「烤蛋糕」是 bake a cake（roast 是烤肉）；「第一次」可以在動詞前加 first，或在句尾寫 for the first time。",
          "evidence": [
            "的地方",
            "烤蛋糕"
          ],
          "strategy_zh": "「（人）做某事的地方／那一天／原因」→ the place where／the day when／the reason why + S + V。",
          "hints": [
            "切成四段：媽媽的廚房／第一次／為朋友烤蛋糕／的地方",
            "標的詞彙：mother（媽媽）、kitchen（廚房）、place（地方）、first（第一次）、bake（烘烤）、cake（蛋糕）、friend（朋友）",
            "句型框架：A + is + the place where + S + V …"
          ]
        },
        "2": {
          "explanation_zh": "「從那天起，我已經…」說的是從過去某一天一直延續到現在的經驗，用 since that day（或 since then）配現在完成式 I have baked。「好幾個蛋糕」用複數 several cakes。「烤給家人和朋友」是 bake … for my family and friends（為某人做東西用 for）。",
          "evidence": [
            "從那天起",
            "我已經烤了"
          ],
          "strategy_zh": "看到「從…起」「自從…以來」，主要子句先想 have/has + p.p.；since 後面接時間點，for 後面接一段時間。",
          "hints": [
            "切成四段：從那天起／我已經烤了／好幾個蛋糕／給家人和朋友",
            "標的詞彙：since（自從）、bake（烘烤）、cake（蛋糕）、family（家人）、friend（朋友）",
            "句型框架：Since + 過去時間點, S + have/has + p.p. …"
          ]
        }
      }
    },
