  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「可以自己做蛋糕的店」是放在名詞前面的修飾語，英文改成名詞後面的子句：a shop where I could make a cake myself。子句說的是「在那家店裡」可以做什麼，子句本身缺的是地點，所以用關係副詞 where（＝in which），不用 which。整句說過去的事，用 went、could；「自己做」是 make … myself／by myself，或 make my own cake。",
          "evidence": [
            "可以自己做蛋糕的店",
            "母親節前"
          ],
          "strategy_zh": "選關係詞時，把子句單獨拿出來看缺什麼：缺主詞或受詞用 who／which／that，缺地點用 where，缺時間用 when。",
          "hints": [
            "切成四段：母親節前／我去了／可以自己做蛋糕的／店（英文語序：… I went to a shop where I could make a cake myself）",
            "標的詞彙：Mother's Day（母親節）、go（去）、shop（店）、make／bake（做）、cake（蛋糕）、myself（自己）",
            "句型框架：S + V + a + 地點名詞 + where + S + V …"
          ]
        },
        "2": {
          "explanation_zh": "「從那天起」表示從過去某一天一直到現在，用 since that day（或 since then）搭配現在完成式 have (already) made；「已經」也是完成式的訊號。make 的過去分詞是不規則的 made。「三個蛋糕」用複數 cakes；「給家人吃」寫 for my family（to eat）即可。",
          "evidence": [
            "從那天起",
            "已經做了三個蛋糕"
          ],
          "strategy_zh": "since＋過去時間點 → 主要子句用 have/has + p.p.；寫完檢查不規則動詞的過去分詞（make-made）。",
          "hints": [
            "切成四段：從那天起／我已經做了／三個蛋糕／給家人吃",
            "標的詞彙：since（從…起）、already（已經）、make／bake（做）、cake（蛋糕）、family（家人）",
            "句型框架：Since + 過去時間, S + have/has + already + p.p. …"
          ]
        }
      }
    },
