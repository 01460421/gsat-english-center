  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「好讓他能…」說明爸爸抱起弟弟的目的，用 so that + 主詞 + could + 原形動詞；整件事發生在過去，用 could。「抱起來」是 pick up 或 lift up（hug 是擁抱）；受詞是名詞時可以放在 up 前後，是代名詞時一定放中間（pick him up）。「看清楚」是 see … clearly。",
          "evidence": [
            "好讓他能",
            "抱了起來"
          ],
          "strategy_zh": "「好讓／以便＋某人能…」→ so that + S + can/could + 原形動詞；主要子句是過去式時用 could。",
          "hints": [
            "切成四段：爸爸／把弟弟抱了起來／好讓他能／看清楚那隻獅子",
            "標的詞彙：father（爸爸）、pick up（抱起、舉起）、brother（弟弟）、lion（獅子）、clearly（清楚地）",
            "句型框架：S + V（過去式）… so that + S + could + 原形動詞 …"
          ]
        },
        "2": {
          "explanation_zh": "「已經住了快二十年」說的是從過去持續到現在的狀態，用現在完成式 has lived（或現在完成進行式 has been living），配 for + 一段時間：for almost twenty years。主詞 this lion 是單數，用 has；twenty 後面的 year 要加 s。",
          "evidence": [
            "已經快二十年了",
            "住在這座動物園"
          ],
          "strategy_zh": "「已經…（多久）了」→ have/has + p.p. + for + 一段時間；先確認主詞單複數再選 have 或 has。",
          "hints": [
            "切成四段：這隻獅子／住在／這座動物園／快二十年了",
            "標的詞彙：lion（獅子）、live（居住）、zoo（動物園）、almost（將近）、year（年）",
            "句型框架：S + has + p.p. … for + 一段時間"
          ]
        }
      }
    },
