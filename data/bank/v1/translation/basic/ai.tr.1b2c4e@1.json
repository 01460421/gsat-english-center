  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「…是…的時候」說的是一段時間，英文用 the time when ＋完整子句；when 在子句裡當時間副詞（等於 in which）。「忙著找」是 be busy + V-ing：are busy looking for。主詞 clubs 是複數，be 動詞用 are；如果寫 every club，就要改成單數 is。",
          "evidence": [
            "的時候",
            "忙著找新社員"
          ],
          "strategy_zh": "中文「是…的時候／地方／原因」常對應英文 the time when／the place where／the reason why，後面接完整子句。",
          "hints": [
            "切成四段：開學第一週／各個社團／忙著找新社員／（是…）的時候",
            "標的詞彙：week（週）、club（社團）、busy（忙著）、look for（找）、member（社員）",
            "句型框架：S + is + the time when + S + V …"
          ]
        },
        "2": {
          "explanation_zh": "「到目前為止」（so far／up to now）加上「已經」，表示從開學到現在累積的結果，要用現在完成式 have joined。「五十多位」是 more than fifty（或 over fifty），名詞用複數 students。join 是及物動詞，直接接社團：join the dance club。",
          "evidence": [
            "到目前為止",
            "已經加入了"
          ],
          "strategy_zh": "so far、up to now、already 常和現在完成式一起出現；看到「到目前為止」先檢查動詞是不是 have/has + p.p.。",
          "hints": [
            "切成四段：到目前為止／五十多位新生／已經加入了／熱舞社",
            "標的詞彙：so far（到目前為止）、student（學生（新生））、join（加入）、dance（舞蹈（熱舞））、club（社團）",
            "句型框架：So far, S + have/has + p.p. …"
          ]
        }
      }
    },
