  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「藉由…」用 By＋動名詞表示方法：By putting on sunscreen；by 是介系詞，後面不能接原形動詞。「擦」防曬乳是塗在皮膚上，用 put on／apply／use，不用 wipe（擦掉）。「保護 A 不受 B 傷害」是 protect A from B；skin 在這裡是不可數名詞，不加 s。",
          "evidence": [
            "藉由擦防曬乳",
            "保護皮膚不受陽光傷害"
          ],
          "strategy_zh": "「藉由／透過做某事」→ By＋V-ing, S＋V；整句真正的主詞（we）放在逗號後面。",
          "hints": [
            "切成四段：藉由擦防曬乳／我們可以保護／皮膚／不受陽光傷害",
            "標的詞彙：put on（擦上、塗上）、protect（保護）、skin（皮膚）、sun（陽光）",
            "句型框架：By + V-ing …, S + can + VR …"
          ]
        },
        "2": {
          "explanation_zh": "「已經提醒…好幾次」是到現在為止的經驗，用現在完成式 has reminded（主詞 our PE teacher 是單數，用 has）。「好幾次」是 many／several times，time 指次數時是可數名詞，要加 s。「提醒某人做某事」是 remind sb to VR。",
          "evidence": [
            "已經提醒我們好幾次",
            "上課前一定要擦防曬乳"
          ],
          "strategy_zh": "「已經…過幾次」→ have/has＋p.p.＋… times；次數片語常放在受詞後面。",
          "hints": [
            "切成四段：體育老師／已經提醒我們／好幾次／上課前一定要擦防曬乳",
            "標的詞彙：teacher（老師）、remind（提醒）、time（次）、put on（擦上）、class（課）",
            "句型框架：S + has + p.p. + sb + … times + to VR …"
          ]
        }
      }
    },
