  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「A 和 B 一樣＋形容詞」用原級比較 as + 形容詞 + as：was as blue as。後面比較的對象是「照片裡（的海）」，寫 as in the photos 或 as it looked in the photos，比只寫 as the photos（拿海和照片本身比）更精確。墾丁是詞彙表外的地名，照題目括號寫 Kenting。",
          "evidence": [
            "和照片裡一樣藍"
          ],
          "strategy_zh": "「和…一樣＋形容詞」→ as + 原級 + as；「沒有…那麼＋形容詞」→ not as + 原級 + as。",
          "hints": [
            "切成四段：這次畢業旅行／墾丁的海水／和照片裡／一樣藍",
            "標的詞彙：graduation（畢業）、trip（旅行）、sea（海水）、blue（藍的）、photo（照片）",
            "句型框架：A + was + as + 形容詞 + as + B"
          ]
        },
        "2": {
          "explanation_zh": "「除了…之外，還…」是補充，用 besides 或 in addition to；它們是介系詞，後面的動詞要用 V-ing：besides playing …。主要子句常搭配 also。「熱鬧的」是 busy／lively／crowded，不是 hot。畢業旅行已經過去，動詞用過去式 visited／went。",
          "evidence": [
            "除了在海邊玩水之外"
          ],
          "strategy_zh": "「除了 A，還 B」用 besides／in addition to + V-ing；「除了 A 以外都…」才用 except。",
          "hints": [
            "切成四段：除了在海邊玩水之外／我們還去逛了／熱鬧的／夜市",
            "標的詞彙：play（玩（水））、visit（逛）、busy（熱鬧的）、night market（夜市）",
            "句型框架：Besides + V-ing …, S + also + 過去式動詞 …"
          ]
        }
      }
    },
