  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "學生是「被要求」的一方，用被動語態 be asked／be required，後面接不定詞 to exercise。主詞 every student 是單數，be 動詞用 is（寫 all students 就用 are）。「至少三十分鐘」是 for at least thirty minutes，minute 要加 s；「每天」是分開的兩個字 every day。",
          "evidence": [
            "被要求"
          ],
          "strategy_zh": "「被要求／被允許／被鼓勵＋做某事」→ be asked／allowed／encouraged + to V。",
          "hints": [
            "切成四段：在我們學校／每位學生都被要求／每天／運動至少三十分鐘",
            "標的詞彙：school（學校）、student（學生）、ask（要求）、exercise（運動）、minute（分鐘）、day（天）",
            "句型框架：S + is/are + p.p. + to + 原形動詞 …"
          ]
        },
        "2": {
          "explanation_zh": "「已經…快兩年了」表示從過去一直持續到現在，用現在完成式 have kept，加上 for + 一段時間（for almost two years）。主詞是「我和同學」，英文習慣把 I 放最後：My classmates and I，動詞用 have。「運動習慣」是 exercise habit 或 the habit of exercising。",
          "evidence": [
            "已經維持",
            "快兩年了"
          ],
          "strategy_zh": "for + 一段時間、since + 起點，常和現在完成式一起出現；先看句子裡有沒有這類時間詞。",
          "hints": [
            "切成四段：我和同學／已經維持／這個運動習慣／快兩年了",
            "標的詞彙：classmate（同學）、keep（維持）、exercise（運動）、habit（習慣）、almost（快（將近））、year（年）",
            "句型框架：S + have/has + p.p. … for + 一段時間"
          ]
        }
      }
    },
