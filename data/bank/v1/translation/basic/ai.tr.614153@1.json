  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「這張全家福是…拍的」主詞是照片，照片是「被拍」的，所以用被動語態 was taken（過去發生的事用 was）；不要寫成主動的 took，也不要寫 was took（take 的過去分詞是 taken）。「全家福」可寫 family photo 或 a photo of our whole family。「我爺爺的老房子」用所有格 my grandfather's old house；「在…前面」是 in front of（不加 the）。",
          "evidence": [
            "這張全家福",
            "是在我爺爺的老房子前面拍的"
          ],
          "strategy_zh": "「東西＋是…V 的」而且沒有說是誰做的，英文用被動 be + p.p.。",
          "hints": [
            "切成四段：這張全家福／我爺爺的老房子／前面／拍的（是…拍的）",
            "標的詞彙：family（家庭）、photo（照片）、old（老的）、house（房子）、front（前面）、take（拍）",
            "句型框架：S（物）+ was + p.p. + in front of …"
          ]
        },
        "2": {
          "explanation_zh": "「如果…就會…」是真實條件句：If 子句用現在式（If my grandmother has time），主要子句用 will + 原形（she will tell me）；If 子句裡不用 will。主詞 grandmother 是第三人稱單數，動詞用 has。「告訴我」tell me（say 後面不能直接接人）。「每張照片背後的故事」the story behind each photo，each／every 後面接單數名詞。",
          "evidence": [
            "如果奶奶有時間",
            "每張照片背後的故事"
          ],
          "strategy_zh": "「如果…會…」：If 子句現在式，主要子句 will + 原形。",
          "hints": [
            "切成四段：如果奶奶有時間／她會告訴我／每張照片背後的／故事",
            "標的詞彙：grandmother（奶奶）、time（時間）、tell（告訴）、photo（照片）、story（故事）",
            "句型框架：If + S + V(現在式), S + will + VR …"
          ]
        }
      }
    },
