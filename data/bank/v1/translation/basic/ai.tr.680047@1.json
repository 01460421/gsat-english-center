  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「已經…了」表示到現在已經完成的事，用現在完成式 have already made（make 的過去分詞是 made），already 放在 have 和過去分詞中間。「為了母親節」for Mother's Day（Mother's 要有所有格）；「為媽媽做」是 make sth for sb，介系詞用 for。「一個小禮物」a small gift／a little present。",
          "evidence": [
            "我已經為媽媽做了一個小禮物"
          ],
          "strategy_zh": "「已經＋動詞＋了」通常用 have/has + already + p.p.。",
          "hints": [
            "切成四段：為了母親節／我已經（做了）／為媽媽／一個小禮物",
            "標的詞彙：Mother's Day（母親節）、already（已經）、make（做）、mother（媽媽）、small（小的）、gift（禮物）",
            "句型框架：S + have + already + p.p. + sth + for sb …"
          ]
        },
        "2": {
          "explanation_zh": "「媽媽絕對找不到的地方」修飾「地方」，英文要放在名詞後面，用關係副詞 where 引導：a place where my mother would never find it（where＝in which；子句缺的是地點，所以 find it 的 it 要保留）。如果改用 that／which，就要把 it 拿掉：a place that my mother would never find。「絕對找不到」would never find／will never find；「藏」hide 的過去式是 hid，過去分詞是 hidden。",
          "evidence": [
            "媽媽絕對找不到的地方"
          ],
          "strategy_zh": "「…的地方」修飾語有完整的主詞和動詞時，寫成 a place where + S + V。",
          "hints": [
            "切成四段：我把它藏在／媽媽／絕對找不到／的地方（a place where …）",
            "標的詞彙：hide（藏）、place（地方）、mother（媽媽）、never（絕不）、find（找到）",
            "句型框架：S + hid + it + in a place + where + S + would never + VR …"
          ]
        }
      }
    },
