  "annotations": {
    "explanations": {
      "items": {
        "1": {
          "explanation_zh": "「除了…，我也…」表示兩件事都做，用 besides、in addition to 或 apart from；這些都是介系詞，後面的「慢跑」要寫成動名詞 jogging（jog 要重複 g）。不要用 except，except 是「除了…以外都不」。「走路上學」是 walk to school 或 go to school on foot，不能寫 by walk。",
          "evidence": [
            "除了在公園慢跑",
            "走路上學"
          ],
          "strategy_zh": "「除了 A，也 B」→ Besides + V-ing …, S + also + V …；逗號前是介系詞片語，逗號後才是完整句子。",
          "hints": [
            "切成四段：每天早上／除了／在公園慢跑／（我也會）走路上學",
            "標的詞彙：morning（早上）、jog（慢跑）、park（公園）、walk（走路）、school（學校）",
            "句型框架：Besides + V-ing …, S + also + V …"
          ]
        },
        "2": {
          "explanation_zh": "「越來越多＋名詞」寫成 more and more + 複數名詞；同學是可數名詞，要用 classmates，後面的動詞也用複數形 jog（不加 s）。「在早上」是 in the morning；「和我一起」用 with me（with 後面接受格）。",
          "evidence": [
            "越來越多同學",
            "在早上"
          ],
          "strategy_zh": "看到「越來越多」先寫 more and more，再檢查後面的名詞有沒有加 s、動詞有沒有跟著用複數。",
          "hints": [
            "切成四段：現在／越來越多同學／在早上／和我一起慢跑",
            "標的詞彙：now（現在）、classmate（同學）、jog（慢跑）、morning（早上）",
            "句型框架：More and more + 複數名詞 + V（複數）…"
          ]
        }
      }
    },
