   "top": {
    "summary_zh": "同詞性近義誘答對 ≥2；含片語動詞選項；每格詞性相容選項 ≥3；1 格詞彙聯結",
    "pos_groups_min": null,
    "compatible_options_per_blank": {
     "min": 3,
     "max": null
    },
    "near_synonym_pairs": {
     "min": 2,
     "max": null
